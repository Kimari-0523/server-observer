{
  "name": "server-observer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env self-hosted/server.mjs",
    "test": "node scripts/test.mjs",
    "build": "node scripts/build-assets.mjs",
    "package": "node scripts/package.mjs",
    "scan:release": "node scripts/scan-release.mjs",
    "test:cloudflare": "node --test test/cloudflare.test.mjs",
    "test:unit": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ws": "8.23.0",
    "jose": "6.2.17"
  },
  "devDependencies": {
    "wrangler": "4.163.0",
    "miniflare": "4.20260730.0"
  }
}
